PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/user_management_system

# debug | info | warn | error
LOG_LEVEL=info

# Master switch for Redis. Set to 1 to enable caching, 0 (or anything else) to
# disable it — when disabled every read falls through to MongoDB directly.
IS_REDIS_SERVER_ON=1
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DEFAULT_TTL=3600

FRONTEND_URL=http://localhost:5180

# Use long random strings in real environments - these two must be different.
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
# lax | strict | none (use 'none' + secure cookies only for cross-domain prod)
COOKIE_SAME_SITE=lax
# Optional override, independent of NODE_ENV. Leave unset to follow NODE_ENV
# (secure in production). Set explicitly to 0 if running production mode
# over plain HTTP (no SSL cert yet) - a Secure cookie is silently dropped by
# the browser over HTTP. Set to 1 once you have HTTPS.
# COOKIE_SECURE=0
